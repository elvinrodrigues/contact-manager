# ============================================================================
# frontend/.env.example — Vite frontend environment
# ============================================================================
# cp .env.example .env.local     (.env.local is gitignored)
#
# Only variables prefixed with VITE_ are exposed to the browser. Anything you
# put here ends up in the built JavaScript, so never place a secret in this file.
# ============================================================================

# Public origin of the backend API.
#
# Leave this UNSET for local development: requests then go to "/api" and Vite's
# dev proxy forwards them to http://localhost:8080 (see vite.config.ts).
#
# Set it for any deployed build, to the backend's public URL and no trailing
# slash, e.g.
#   VITE_API_BASE_URL=https://contact-manager-api.onrender.com
VITE_API_BASE_URL=
